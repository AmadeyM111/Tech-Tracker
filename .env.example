POSTGRES_USER=tracker
POSTGRES_PASSWORD=tracker
POSTGRES_DB=tracker
HTTP_PORT=80
HTTPS_PORT=443
TLS_SERVER_NAME=localhost
# Логин первого технического администратора (по умолчанию admin). Значение читается без
# обрезки: пробел или перевод строки по краям дают ошибку запуска api. Пароль создаётся
# при первом запуске и записывается в файл /data/secrets/initial-admin-password.txt.
INITIAL_ADMIN_LOGIN=admin
# Параметры Argon2id (стартовые значения, калибруются на стенде):
# ARGON2_TIME_COST=3
# ARGON2_MEMORY_COST_KIB=131072
# ARGON2_PARALLELISM=2
