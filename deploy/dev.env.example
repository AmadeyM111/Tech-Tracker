# Настройки локальной разработки (скопируйте в .env.dev или экспортируйте в окружение).
DATABASE_URL=postgresql+asyncpg://tracker:tracker@localhost:5432/tracker
COOKIE_SECURE=false
ENV=local
EXPOSE_API_DOCS=true
DATA_DIR=./.data
# Сброс пароля по email (по умолчанию в dev выключен; включается заданием SMTP_HOST и PUBLIC_BASE_URL):
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_STARTTLS=false
# SMTP_FROM=tracker@example.ru
# PUBLIC_BASE_URL=http://localhost:5173
