# Вариант web за обратным прокси (Caddy терминирует TLS; порт публикуется только на 127.0.0.1).
# Прод-сервер монтирует этот файл поверх /etc/nginx/templates/default.conf.template через
# compose.override.yml (см. deploy/web/README.md). До 2026-11-10 это был ручной файл
# /etc/task-tracker/nginx.conf: правки default.conf.template до прода не доходили.
# Переменных нет: подстановка envsubst не требуется (NGINX_ENVSUBST_FILTER не затрагивает файл).
server_tokens off;
server {
    listen 80 default_server;
    server_name _;

    # Вложения до 10 МБ + накладные расходы multipart (FR-24).
    client_max_body_size 12m;
    error_page 413 @payload_too_large;

    # Preserve the upstream application security headers.
    # "always" - заголовки есть и на ошибках (в том числе 502 при недоступном api).
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "same-origin" always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'" always;

    # Встроенный DNS Docker; upstream в переменной разрешается при запросе, поэтому nginx
    # стартует и без запущенного api.
    resolver 127.0.0.11 valid=10s ipv6=off;
    # Без пользовательской сети Docker резолвер молчит: отвечаем 502 за 5 с, а не за 30 с.
    resolver_timeout 5s;

    # Проверка живости для HEALTHCHECK образа: отвечает сам nginx (без api и SPA) и не пишется
    # в access-лог (запрос раз в 10 с засорял бы его).
    set_real_ip_from 172.20.0.1;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;
    location = /healthz {
        access_log off;
        return 200 "ok";
    }

    location @payload_too_large {
        default_type application/json;
        charset utf-8;
        return 413 '{"detail":"Файл слишком большой","code":"attachment_too_large"}';
    }

    location /api/ {
        set $api_upstream http://api:8000;
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        # $http_host: с портом клиента, иначе проверка Origin в api даёт ложный origin_mismatch.
        proxy_set_header Host $http_host;
        # Перезаписываются, клиентские значения не пропускаются.
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 60s;
    }

    # MCP для AI-агентов (ADR-0018, PR #9): api сам проверяет Origin и Bearer-токен, nginx только проксирует.
    location ~ ^/mcp/?$ {
        set $api_upstream http://api:8000;
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_buffering off;
        proxy_read_timeout 3600s;
    }

    # /api никогда не отдаёт index.html.
    location = /api {
        return 404;
    }

    location /assets/ {
        root /usr/share/nginx/html;
        try_files $uri =404;
        expires 1y;
    }

    # SPA: history fallback.
    location / {
        root /usr/share/nginx/html;
        try_files $uri /index.html;
        expires -1;
    }
}
