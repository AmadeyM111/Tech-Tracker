# Конфигурация nginx образа web (plan §4.12, D-17, D-20; FR-63, NFR-4).
# Файл - шаблон образа nginx: подставляется только ${HTTPS_PORT} (NGINX_ENVSUBST_FILTER).

server_tokens off;

# Порт 80: только переадресация на HTTPS, без проксирования и без данных приложения.
server {
    listen 80 default_server;
    server_name _;

    return 308 https://$host:${HTTPS_PORT}$request_uri;
}

server {
    listen 443 ssl default_server;
    server_name _;

    # Сертификат выбирает /docker-entrypoint.d/10-gtrack-tls.sh (символьные ссылки).
    ssl_certificate     /run/gtrack-tls/tls.crt;
    ssl_certificate_key /run/gtrack-tls/tls.key;

    ssl_protocols TLSv1.2 TLSv1.3;
    # Mozilla intermediate без DHE (нет собственных параметров DH).
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # Вложения до 10 МБ + накладные расходы multipart (FR-24).
    client_max_body_size 12m;
    error_page 413 @payload_too_large;

    # Заголовки безопасности; HSTS не включается (самоподписанный сертификат, plan §4.12).
    # "always" - заголовки есть и на ошибках (в том числе 502 при недоступном api).
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "same-origin" always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'" always;

    # Встроенный DNS Docker; upstream в переменной разрешается при запросе, поэтому nginx
    # стартует и без запущенного api.
    resolver 127.0.0.11 valid=10s ipv6=off;
    # Без пользовательской сети Docker резолвер молчит: отвечаем 502 за 5 с, а не за 30 с.
    resolver_timeout 5s;

    # Проверка живости для HEALTHCHECK образа: отвечает сам nginx (без api и SPA) и не пишется
    # в access-лог (запрос раз в 10 с засорял бы его).
    location = /healthz {
        access_log off;
        return 200 "ok";
    }

    location @payload_too_large {
        default_type application/json;
        charset utf-8;
        return 413 '{"detail":"Файл слишком большой","code":"attachment_too_large"}';
    }

    location /api/ {
        set $api_upstream http://api:8000;
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        # $http_host: с портом клиента, иначе проверка Origin в api даёт ложный origin_mismatch.
        proxy_set_header Host $http_host;
        # Перезаписываются, клиентские значения не пропускаются.
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 60s;
        # Скачивание вложения (спека 011) уже несёт nosniff от api, а nginx добавляет свой: без
        # скрытия заголовок задвоился бы. Content-Security-Policy api (sandbox) намеренно остаётся
        # рядом с политикой nginx: браузер применяет обе, то есть их пересечение.
        proxy_hide_header X-Content-Type-Options;
    }

    # MCP для AI-агентов (ADR-0018, спека 020): api сам проверяет Origin и Bearer-токен, nginx только
    # проксирует. Без этого блока /mcp попадал в SPA (location /) и POST отдавал 405 от nginx.
    # Регулярное выражение: точное совпадение с /mcp и /mcp/, а не префикс (например, /mcpx).
    location ~ ^/mcp/?$ {
        set $api_upstream http://api:8000;
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        # $http_host: с портом клиента, иначе проверка Origin в api даёт ложный origin_mismatch.
        proxy_set_header Host $http_host;
        # Перезаписываются, клиентские значения не пропускаются.
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        # Streamable HTTP отдаёт потоковые ответы (SSE): буфер и короткий таймаут рвут сессию.
        proxy_buffering off;
        proxy_read_timeout 3600s;
    }

    # /api никогда не отдаёт index.html.
    location = /api {
        return 404;
    }

    location /assets/ {
        root /usr/share/nginx/html;
        try_files $uri =404;
        expires 1y;
    }

    # SPA: history fallback.
    location / {
        root /usr/share/nginx/html;
        try_files $uri /index.html;
        expires -1;
    }
}
